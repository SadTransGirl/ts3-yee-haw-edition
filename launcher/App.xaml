<Application x:Class="YeeHawLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The launcher's look, after Jessie's outfit: hat red, shirt yellow and cowhide on a
        warm cream, with soft borderless rounded cards. Red is for the main action and the
        sidebar, yellow for everything else you can press, cowhide only in the banner.
        Everything is drawn here; no game art is used.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The cowhide pattern, made by tools/cowhide_spots.py. -->
                <ResourceDictionary Source="Cowhide.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette -->
            <Color x:Key="Background">#FBF3E4</Color>   <!-- window: her shirt's cream -->
            <Color x:Key="Card">#FFFFFF</Color>
            <Color x:Key="Field">#F6ECD9</Color>        <!-- drop-downs, text boxes, quiet tracks -->
            <Color x:Key="FieldHover">#EFE2C8</Color>
            <Color x:Key="Divider">#F1E7D4</Color>
            <Color x:Key="Text">#3B2416</Color>         <!-- dark brown, like her boots and spots -->
            <Color x:Key="Muted">#8C7663</Color>
            <Color x:Key="HatRed">#C9302C</Color>       <!-- main accent -->
            <Color x:Key="HatRedDark">#A82622</Color>
            <Color x:Key="ShirtYellow">#F5D04C</Color>  <!-- second accent -->
            <Color x:Key="ShirtYellowSoft">#FCEDB8</Color>
            <Color x:Key="OnYellow">#4A3305</Color>     <!-- text on yellow -->

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}" />
            <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource Field}" />
            <SolidColorBrush x:Key="FieldHoverBrush" Color="{StaticResource FieldHover}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource HatRed}" />
            <SolidColorBrush x:Key="RedDarkBrush" Color="{StaticResource HatRedDark}" />
            <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource ShirtYellow}" />
            <SolidColorBrush x:Key="YellowSoftBrush" Color="{StaticResource ShirtYellowSoft}" />
            <SolidColorBrush x:Key="OnYellowBrush" Color="{StaticResource OnYellow}" />

            <!-- Fonts: Luckiest Guy (Apache 2.0) and Rope MF (freeware) are embedded; see Fonts\. -->
            <FontFamily x:Key="TitleFont">pack://application:,,,/Fonts/#Luckiest Guy</FontFamily>
            <FontFamily x:Key="RopeFont">pack://application:,,,/Fonts/#Rope MF</FontFamily>
            <FontFamily x:Key="BodyFont">Bahnschrift, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- The soft shadow under cards, in place of borders. -->
            <DropShadowEffect x:Key="CardShadow" Color="#7A5A3A" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.12" />

            <!-- Jessie's sheriff star: a gold five-pointed badge with a ball on each tip, in a
                 220x220 frame (points from a radius-90/38 star centred at 110,110). -->
            <LinearGradientBrush x:Key="StarGold" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FBE07A" Offset="0" />
                <GradientStop Color="#E8B530" Offset="0.5" />
                <GradientStop Color="#B9831A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StarGoldLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF0AE" Offset="0" />
                <GradientStop Color="#F3C94A" Offset="0.6" />
                <GradientStop Color="#D9A22A" Offset="1" />
            </LinearGradientBrush>
            <Pen x:Key="StarEdge" Brush="#7E5310" Thickness="5" LineJoin="Round" />
            <DrawingImage x:Key="SheriffStar">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,220,220" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource StarGold}" Pen="{StaticResource StarEdge}">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="110,20" RadiusX="14" RadiusY="14" />
                                    <EllipseGeometry Center="195.6,82.2" RadiusX="14" RadiusY="14" />
                                    <EllipseGeometry Center="162.9,182.8" RadiusX="14" RadiusY="14" />
                                    <EllipseGeometry Center="57.1,182.8" RadiusX="14" RadiusY="14" />
                                    <EllipseGeometry Center="24.4,82.2" RadiusX="14" RadiusY="14" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource StarGold}" Pen="{StaticResource StarEdge}"
                            Geometry="M110.0,20.0 L132.3,79.3 L195.6,82.2 L146.1,121.7 L162.9,182.8 L110.0,148.0 L57.1,182.8 L73.9,121.7 L24.4,82.2 L87.7,79.3Z" />
                        <GeometryDrawing Brush="{StaticResource StarGoldLight}"
                            Geometry="M110.0,36.0 L128.2,84.9 L180.4,87.1 L139.5,119.6 L153.5,169.9 L110.0,141.0 L66.5,169.9 L80.5,119.6 L39.6,87.1 L91.8,84.9Z" />
                        <GeometryDrawing Brush="{StaticResource StarGold}">
                            <GeometryDrawing.Pen><Pen Brush="#7E5310" Thickness="3" /></GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry><EllipseGeometry Center="110,104" RadiusX="22" RadiusY="22" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#80FFFFFF">
                            <GeometryDrawing.Geometry><EllipseGeometry Center="103,96" RadiusX="7" RadiusY="5" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>


            <!-- Buttons: soft rounded pills. The default is the red call to action. -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource RedBrush}" />
                <Setter Property="Padding" Value="26,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A yellow pill for the other actions (Save, presets). -->
            <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Foreground" Value="{StaticResource OnYellowBrush}" />
                <Setter Property="Background" Value="{StaticResource YellowBrush}" />
            </Style>

            <!-- Sidebar navigation on the red strip: icon over label; the open page is a yellow pill. -->
            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#F6DCD6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="10,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Face" Background="Transparent" CornerRadius="12" Padding="8,12">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource RedDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource YellowBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OnYellowBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- On/off switches: a cream track that turns hat red, with a white knob. -->
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="24" Background="Transparent">
                                <Border x:Name="Track" CornerRadius="12" Background="{StaticResource FieldHoverBrush}" />
                                <Ellipse Width="18" Height="18" Fill="White" x:Name="Knob"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource RedBrush}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Scroll bars: a slim rounded thumb, no arrows or track. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#E4D3B5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text boxes: cream, rounded. -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource RedBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="10,6">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Drop-downs: a cream rounded box with a chevron, and a white list with a soft shadow. -->
            <Style x:Key="ComboToggle" TargetType="ToggleButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Face" Background="{StaticResource FieldBrush}" CornerRadius="8">
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="4,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource FieldBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                                  Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade">
                                    <!-- Margin leaves room for the shadow inside the popup. -->
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="6,4,6,10" Padding="0,4"
                                            Effect="{StaticResource CardShadow}"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
