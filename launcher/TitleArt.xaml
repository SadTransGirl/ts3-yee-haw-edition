<UserControl x:Class="YeeHawLauncher.TitleArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="640" FontFamily="{StaticResource BodyFont}">
    <!--
        The project's title image (GitHub social preview and README header), drawn with the
        launcher's own fonts and colours: no game art. Rendered by the launcher's logo mode (see App.xaml.cs).
    -->
    <Grid>
        <!-- Cowhide over white, framed by hat red with the brim's white stitching. -->
        <Border Background="{StaticResource RedBrush}" />
        <Border Margin="28" CornerRadius="28" Background="{StaticResource CardBrush}" />
        <Border Margin="28" CornerRadius="28">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,760,380" ViewportUnits="Absolute"
                              Viewbox="0,0,360,180" ViewboxUnits="Absolute" Stretch="Fill"
                              Drawing="{Binding Drawing, Source={StaticResource CowhideBrush}}" />
            </Border.Background>
        </Border>
        <Rectangle Margin="14" RadiusX="36" RadiusY="36" Stroke="#FFF6E6" StrokeThickness="3" StrokeDashArray="3 3" />

        <!-- The title on a white label, like a sign tacked onto the hide, with Jessie's sheriff
             star pinned over its top-left corner. -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border CornerRadius="24" Background="{StaticResource CardBrush}" Padding="64,36,64,44">
                <Border.Effect>
                    <DropShadowEffect Color="#3B2416" BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.35" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOY STORY 3" FontFamily="{StaticResource TitleFont}" FontSize="40"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Yee Haw Edition" FontFamily="{StaticResource TitleFont}" FontSize="112"
                               Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Border Width="180" Height="10" CornerRadius="5" Background="{StaticResource YellowBrush}"
                            HorizontalAlignment="Center" Margin="0,4,0,22" />
                    <TextBlock Text="Online co-op, sharper graphics and a few surprises" FontSize="30"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Image Source="{StaticResource SheriffStar}" Width="190" Height="190" HorizontalAlignment="Left"
                   VerticalAlignment="Top" Margin="-92,-96,0,0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><RotateTransform Angle="-14" /></Image.RenderTransform>
                <Image.Effect>
                    <DropShadowEffect Color="#3B2416" BlurRadius="18" ShadowDepth="6" Direction="290" Opacity="0.45" />
                </Image.Effect>
            </Image>
        </Grid>
    </Grid>
</UserControl>
